<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:orientation="vertical"
    android:background="@drawable/bg">
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <ImageView
                android:layout_width="100sp"
                android:layout_height="100sp"
                android:background="@drawable/icon"
                android:layout_gravity="center"
                android:layout_marginTop="80sp">
            </ImageView>
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="WELCOME"
    android:textSize="40sp"
    android:textStyle="bold"
    android:fontFamily="serif"
    android:textAlignment="center"
    android:layout_gravity="center"
    android:layout_marginTop="40sp"
    android:textColor="@color/peacockBlue">
</TextView>
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter your credential to login"
                android:textColor="@color/peacockBlue"
                android:gravity="center"
                android:fontFamily="serif"
                android:layout_marginBottom="50sp"
                android:textSize="18sp">
            </TextView>
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="80sp"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp"
        android:layout_marginTop="30sp"
        android:padding="10sp"
        android:textColorHint="@color/lightBlack"
        app:startIconDrawable="@drawable/baseline_email_24"
        app:endIconMode="clear_text"
        app:startIconTint="@color/lightBlack"
        app:endIconTint="@color/lightBlack">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="text"
            android:textColor="@color/black"
            android:id="@+id/txt_loginemail"
            android:hint="Enter Your E-mail Address">
        </com.google.android.material.textfield.TextInputEditText>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="80sp"
        android:layout_marginLeft="10sp"
        android:layout_marginRight="10sp"
        android:padding="10sp"
        android:textColorHint="@color/lightBlack"
        app:startIconDrawable="@drawable/baseline_lock_24"
        app:startIconTint="@color/lightBlack"
        app:endIconTint="@color/lightBlack"
        app:endIconMode="password_toggle">

        <com.google.android.material.textfield.TextInputEditText
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:inputType="textPassword"
            android:textColor="@color/black"
            android:id="@+id/txt_loginpassword"
            android:hint="Enter Your Password">
        </com.google.android.material.textfield.TextInputEditText>

    </com.google.android.material.textfield.TextInputLayout>

<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="NEW USER? RESGISTER NOW."
    android:textColor="@color/navyBlue"
    android:layout_gravity="right"
    android:layout_marginRight="20sp"
    android:layout_marginTop="18sp"
    android:fontFamily="sans-serif-smallcaps"
    android:textSize="12sp"
    android:id="@+id/text_goToRegister">
</TextView>
    <com.google.android.material.button.MaterialButton
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="SIGN IN"
        android:layout_marginTop="30dp"
        android:layout_gravity="center"
        android:textSize="20sp"
        android:textColor="@color/white"
        android:layout_marginRight="20dp"
        android:layout_marginLeft="20dp"
        android:id="@+id/btn"
        android:backgroundTint="@color/peacockBlue">
    </com.google.android.material.button.MaterialButton>
        </LinearLayout>
    </ScrollView>
</LinearLayout>