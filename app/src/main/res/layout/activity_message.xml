<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Message">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="55sp"
        android:orientation="horizontal"
        android:padding="10sp"
        android:id="@+id/layout_msgtop"
        android:background="@color/navyBlue">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/msgBack"
            android:layout_marginLeft="5sp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/baseline_keyboard_backspace_24">
        </ImageView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Username"
            android:textColor="@color/white"
            android:layout_marginLeft="15dp"
            android:textSize="20sp"
            android:id="@+id/txt_msgusername"
            android:layout_gravity="center_vertical">
        </TextView>
    </LinearLayout>
  <androidx.recyclerview.widget.RecyclerView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@+id/layout_msgtop"
      android:layout_above="@+id/layout_msgbottom"
      android:background="@drawable/chatbg"
      android:id="@+id/msg_recycler">
  </androidx.recyclerview.widget.RecyclerView>
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layout_msgbottom"
        android:layout_alignParentBottom="true">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Message"
            app:boxCornerRadiusTopStart="25dp"
            app:boxCornerRadiusTopEnd="25dp"
            app:boxCornerRadiusBottomStart="25dp"
            app:boxCornerRadiusBottomEnd="25sp"
            android:backgroundTint="@color/white"
            android:scrollbarStyle="insideOverlay"
            android:layout_alignParentLeft="true"
            android:layout_toLeftOf="@+id/msg_send"
            android:id="@+id/layout_msglayout">
            <com.google.android.material.textfield.TextInputEditText
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:id="@+id/txt_msgbox"
                android:maxHeight="100sp">
            </com.google.android.material.textfield.TextInputEditText>
        </com.google.android.material.textfield.TextInputLayout>
        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="50sp"
            android:layout_height="50sp"
            android:id="@+id/msg_send"
            app:civ_circle_background_color="@color/navyBlue"
            android:layout_centerVertical="true"
            android:src="@drawable/baseline_send_24"
            app:civ_border_width="2sp"
            app:civ_border_overlay="false"
            app:civ_border_color="@color/navyBlue"
            android:layout_alignParentEnd="true">
        </de.hdodenhof.circleimageview.CircleImageView>
    </RelativeLayout>
</RelativeLayout>