<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ProfileFragment"
    android:background="@drawable/profilephoto"
    android:orientation="vertical"
>    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/navyBlue"
                    android:layout_marginLeft="30sp"
                    android:layout_marginBottom="20sp"
                    android:orientation="horizontal">

                    <de.hdodenhof.circleimageview.CircleImageView
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/profile_image"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:src="@drawable/baseline_person_24"
        app:civ_border_width="4dp"
        app:civ_border_color="@color/white"
        android:layout_gravity="center"
        android:layout_marginBottom="5sp"
         android:layout_marginTop="15sp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:backgroundTint="@color/navyBlue"
                    android:layout_marginLeft="30sp"
                    android:layout_marginTop="20sp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="admin name"
        android:textAllCaps="true"
        android:textColor="@color/white"
        android:id="@+id/adminName"
        android:layout_marginTop="15sp"
        android:textSize="22sp"
        android:textStyle="bold">
    </TextView>
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="admin@gmail.com"
            android:id="@+id/profile_email"
            android:layout_marginTop="7sp"
            android:textColor="@color/white"
            android:textSize="15sp">
        </TextView>
                    <com.google.android.material.button.MaterialButton
                        android:layout_width="wrap_content"
                        android:layout_height="40sp"
                        android:layout_marginTop="8sp"
                        android:backgroundTint="@color/white"
                        android:text="Change Profile 📷"
                        android:id="@+id/profile_btn"
                        android:textSize="12sp"
                        android:textColor="@color/black"
                        app:cornerRadius="0sp">
                    </com.google.android.material.button.MaterialButton>
                </LinearLayout>
        </LinearLayout>
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:minHeight="30sp"
                app:cardCornerRadius="15sp"
                android:layout_margin="15sp"
                android:backgroundTint="@color/white"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:minHeight="30sp"
                    android:orientation="horizontal"
                    android:weightSum="7">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Do not Disturb"
                        android:textSize="15sp"
                        android:id="@+id/aboutprofile"
                        android:layout_gravity="center_vertical"
                        android:textColor="@color/peacockBlue"
                        android:fontFamily="sans-serif-black"
                        android:layout_marginLeft="30sp"
                        android:layout_weight="6">
                    </TextView>
                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/baseline_create_24"
                        android:layout_gravity="center"
                        android:id="@+id/img_changeabout"
                        android:layout_weight="1">
                    </ImageView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                app:cardCornerRadius="20sp"
                android:layout_marginTop="10sp"
                android:layout_margin="20dp"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/white"
                    android:padding="20sp"
                    android:orientation="vertical">
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Admin Name"
                app:endIconMode="clear_text">
                <com.google.android.material.textfield.TextInputEditText
                    android:backgroundTint="@color/black"
                    android:layout_width="match_parent"
                    android:id="@+id/profile_name"
                    android:layout_height="wrap_content">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Gender"
                app:endIconMode="clear_text"
                android:layout_marginTop="10sp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/profile_gender">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="BirthDate"
                app:endIconMode="clear_text"
                android:layout_marginTop="10sp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:id="@+id/profile_birthdate"
                    android:layout_height="wrap_content">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="City"
                app:endIconMode="clear_text"
                android:layout_marginTop="10sp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/profile_city">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Mobile No."
                app:endIconMode="clear_text"
                android:layout_marginTop="10sp">
                <com.google.android.material.textfield.TextInputEditText
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:id="@+id/profile_mobno">
                </com.google.android.material.textfield.TextInputEditText>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton
                android:layout_width="match_parent"
                android:layout_margin="15sp"
                android:id="@+id/profile_update"
                android:layout_height="wrap_content"
                android:text="Update Profile">
            </com.google.android.material.button.MaterialButton>
    </LinearLayout>
</androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>