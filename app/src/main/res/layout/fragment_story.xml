<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".StoryFragment"
    android:orientation="vertical"
    android:padding="10sp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Stories"
        android:textSize="25sp"
        android:textColor="@color/black"
        android:fontFamily="sans-serif-condensed-medium">
    </TextView>
<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10sp">
    <de.hdodenhof.circleimageview.CircleImageView
        android:layout_width="55sp"
        android:layout_height="55sp"
        android:src="@drawable/baseline_person_24blue"
        android:id="@+id/img_mystory"
        app:civ_border_width="2sp"
        app:civ_border_color="@color/peacockBlue">
    </de.hdodenhof.circleimageview.CircleImageView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="My story"
        android:layout_toRightOf="@+id/img_mystory"
        android:textSize="18sp"
        android:fontFamily="sans-serif-condensed"
        android:layout_marginLeft="10sp"
        android:layout_marginTop="4sp"
        android:id="@+id/txt_mystory">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="+ Tap to add story"
        android:layout_toRightOf="@+id/img_mystory"
        android:layout_below="@+id/txt_mystory"
        android:textSize="10sp"
        android:fontFamily="sans-serif-condensed"
        android:textColor="@color/lightgray"
        android:layout_marginLeft="10sp"
        android:id="@+id/txt_abc">
    </TextView>
</RelativeLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Recent Updates"
        android:textSize="24sp"
        android:layout_marginTop="20sp"
        android:textColor="@color/black"
        android:fontFamily="sans-serif-condensed-medium">
    </TextView>
    <androidx.recyclerview.widget.RecyclerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="15sp"
        android:id="@+id/recycler_recentupdates">
    </androidx.recyclerview.widget.RecyclerView>
</LinearLayout>