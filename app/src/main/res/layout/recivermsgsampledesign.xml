<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="10sp"
    android:background="@color/lightgray"
    android:layout_gravity="left"
    android:layout_margin="10sp"
    android:elevation="3sp">
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="250sp"
        android:text="Hello Friend!"
        android:id="@+id/txt_receivermsg"
        android:minWidth="100dp"
        android:layout_alignParentTop="true">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="5:30 PM"
        android:textSize="11sp"
        android:id="@+id/txt_receivermsgtime"
        android:layout_alignRight="@+id/txt_receivermsg"
        android:layout_below="@+id/txt_receivermsg"
        android:textColor="@color/lightBlack">
    </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="20/09/2024"
        android:textSize="11sp"
        android:id="@+id/txt_receivermsgdate"
        android:layout_alignRight="@+id/txt_receivermsg"
        android:layout_below="@+id/txt_receivermsgtime"
        android:textColor="@color/lightBlack">
    </TextView>
</RelativeLayout>