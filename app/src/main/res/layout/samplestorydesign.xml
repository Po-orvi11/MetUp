<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:padding="10sp">

    <RelativeLayout
        android:id="@+id/image_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">


        <de.hdodenhof.circleimageview.CircleImageView
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_centerInParent="true"
            android:padding="6dp"
            android:src="@drawable/baseline_person_24blue"
            android:id="@+id/img_status"/>

        <com.devlomi.circularstatusview.CircularStatusView
            android:id="@+id/circular_status_view"
            android:layout_width="65dp"
            android:layout_height="65dp"
            android:layout_centerInParent="true"
            android:clipToOutline="true"
            app:portion_color="@color/navyBlue"
            app:portion_spacing="4sp"
            app:portion_width="3sp"
            app:portions_count="7" />

    </RelativeLayout>
<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical">
   <TextView
       android:layout_width="wrap_content"
       android:layout_height="wrap_content"
       android:text="User Name"
       android:id="@+id/txt_statususername"
       android:layout_marginTop="9sp"
       android:layout_marginLeft="10sp"
       android:textSize="18dp">
   </TextView>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:05PM | 23-09-2024"
        android:layout_marginTop="3sp"
        android:layout_marginLeft="10sp"
        android:textSize="12sp"
        android:id="@+id/txt_statustime">
    </TextView>
</LinearLayout>
</LinearLayout>